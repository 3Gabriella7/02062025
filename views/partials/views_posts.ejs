<% console.log("Posts list: ",JSON.stringify(dados)) %>
<table>
    <thead>
    </thead>
    <tbody>
        <% let i;for(i = 0;i< dados.length; i++) { %>
        <tr>
            <td><%= dados[i].id %></td>
            <td><%= dados[i].id_users %></td>
            <td><%= dados[i].titulo %></td>
            <td><%= dados[i].conteudo %></td>
            <td><%= dados[i].data_criacao %></td>
        </tr>
        <% } %>
    </tbody>
    <tfoot>
        <tr>
            <td colspan="20">Quantidade de post encontrados <%= dados.length %></td>
        </tr>
    </tfoot>
</table>
